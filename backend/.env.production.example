# Copier dans .env sur le serveur et remplacer les valeurs d'exemple.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://caapmedia:CHANGE_ME@127.0.0.1:5432/caapmedia?schema=public
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=https://caapmedia.com,https://www.caapmedia.com
FRONTEND_URL=https://caapmedia.com
PUBLIC_API_URL=https://www.caapmedia.com/api-caapmedia
PUBLIC_BACKEND_URL=https://www.caapmedia.com

# Requis en production pour les images produits.
PRODUCT_IMAGE_STORAGE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=caapmedia
R2_PUBLIC_BASE_URL=https://images.caapmedia.com

# Requis pour les e-mails, réinitialisations de mot de passe et proformas.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CaapMedia <no-reply@caapmedia.com>"
