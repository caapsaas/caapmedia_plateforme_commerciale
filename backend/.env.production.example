# Copier dans .env sur le serveur et remplacer les valeurs d'exemple.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://caapmedia:CHANGE_ME@127.0.0.1:5432/caapmedia?schema=public
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=https://caapmedia.com,https://www.caapmedia.com
FRONTEND_URL=https://caapmedia.com
PUBLIC_API_URL=https://www.caapmedia.com/api-caapmedia
PUBLIC_BACKEND_URL=https://www.caapmedia.com

# Requis en production pour les images produits.
PRODUCT_IMAGE_STORAGE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=caapmedia
R2_PUBLIC_BASE_URL=https://images.caapmedia.com
# Optional object key used by the read-only R2 audit check.
R2_AUDIT_OBJECT_KEY=

# Requis pour les e-mails, réinitialisations de mot de passe et proformas.
# N0C: use the outgoing SMTP host from the mailbox's Account Settings.
# Port 587 uses STARTTLS (SMTP_SECURE=false); port 465 uses implicit TLS (SMTP_SECURE=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER. Use the authenticated mailbox or an authorized alias.
SMTP_FROM=
# Optional: base64-encoded PEM CA certificate for a private SMTP TLS chain.
# Keep certificate validation enabled; do not disable SMTP TLS verification.
SMTP_TLS_CA_BASE64=

# WhatsApp Cloud API. Set the Graph version for your Meta app (format vNN.0).
# Use an approved French proforma template with a DOCUMENT header and one
# positional body parameter for the proforma number.
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PROFORMA_TEMPLATE=proforma_caapmedia

# Optional backend-only key for the Gemini model-list audit probe.
GEMINI_API_KEY=
