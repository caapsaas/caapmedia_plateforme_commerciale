generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subsidiary {
  id                    String                 @id @default(uuid()) @map("id") @db.Uuid
  subsidiaryName        String                 @map("subsidiary_name") @db.VarChar(255)
  logoSvg               String                 @map("logo_svg")
  address               String                 @map("address")
  phone                 String                 @map("phone") @db.VarChar(255)
  email                 String                 @unique @map("email") @db.VarChar(255)
  ifu                   String                 @map("ifu") @db.VarChar(255)
  rccm                  String                 @map("rccm") @db.VarChar(255)
  bankName              String                 @map("bank_name") @db.VarChar(255)
  accountNumber         String                 @map("account_number") @db.VarChar(255)
  swiftCode             String                 @map("swift_code") @db.VarChar(255)
  shareCapital          Decimal                @map("share_capital") @db.Decimal(15, 2)
  absenceRecords        AbsenceRecord[]
  accounts              Account[]
  attendanceRecords     AttendanceRecord[]
  companyDocuments      CompanyDocument[]
  contacts              Contact[]
  contracts             Contract[]
  creditAccounts        CreditAccount[]
  employees             Employee[]
  equipments            Equipment[]
  expenseRecords        ExpenseRecord[]
  financialTransactions FinancialTransaction[]
  fixedAssets           FixedAsset[]
  leads                 Lead[]
  longTermDepts         LongTermDebt[]
  meetings              Meeting[]
  opportunities         Opportunity[]
  orders                Order[]
  payrollRecords        PayrollRecord[]
  products              Product[]
  purchaseOrders        PurchaseOrder[]
  sales                 Sale[]
  secretariatTasks      SecretariatTask[]
  supplierDebts         SupplierDebt[]
  suppliers             Supplier[]
  treasuryAccounts      TreasuryAccount[]
  users                 User[]

  @@map("subsidiaries")
}

model User {
  id            String        @id @default(uuid()) @map("id") @db.Uuid
  userName      String        @map("user_name") @db.VarChar(255)
  email         String        @unique @map("email") @db.VarChar(255)
  passwordHash  String        @map("password_hash")
  subsidiaryId  String        @map("subsidiary_id") @db.Uuid
  userRole      UserRole      @map("user_role")
  accounts      Account[]
  contacts      Contact[]
  crmTasks      CrmTask[]
  interactions  Interaction[]
  opportunities Opportunity[]
  orders        Order[]
  sales         Sale[]
  subsidiary    Subsidiary    @relation(fields: [subsidiaryId], references: [id])

  @@map("users")
}

model ConfigurableOptionItem {
  id                  Int                  @id @default(autoincrement()) @map("id")
  optionName          String               @unique @map("option_name") @db.VarChar(150)
  multiplier          Decimal              @map("multiplier") @db.Decimal(15, 2)
  configurableOptions ConfigurableOption[]

  @@map("configurable_option_item")
}

model Product {
  id                   String               @id @default(uuid()) @map("id") @db.Uuid
  productName          String               @map("product_name") @db.VarChar(255)
  mainCategory         String               @map("main_category") @db.VarChar(255)
  category             String               @map("category") @db.VarChar(255)
  description          String               @map("description")
  stock                Decimal              @map("stock")
  price                Decimal              @map("price") @db.Decimal(15, 2)
  sellingPrice         Decimal              @map("selling_price") @db.Decimal(15, 2)
  warehouse            String               @map("warehouse") @db.VarChar(255)
  productRange         String?              @map("product_range") @db.VarChar(255)
  subsidiaryId         String               @map("subsidiary_id") @db.Uuid
  configurableOptions  ConfigurableOption[]
  opportunitieProducts OpportunityProduct[]
  orderItems           OrderItem[]
  productImages        ProductImage[]
  subsidiary           Subsidiary           @relation(fields: [subsidiaryId], references: [id])
  purchaseOrderItems   PurchaseOrderItem[]

  @@map("products")
}

model ConfigurableOption {
  id         Int                     @id @default(autoincrement()) @map("id")
  productId  String?                 @map("product_id") @db.Uuid
  itemId     Int?                    @map("item_id")
  optionType OptionType              @map("option_type")
  item       ConfigurableOptionItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  product    Product?                @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("configurable_options")
}

model ProductImage {
  id        Int      @id @default(autoincrement()) @map("id")
  imageName String   @map("image_name") @db.VarChar(255)
  imageUrl  String   @map("image_url")
  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_image")
}

model Employee {
  id                       String                      @id @default(uuid()) @map("id") @db.Uuid
  lastName                 String                      @map("last_name") @db.VarChar(100)
  firstName                String                      @map("first_name") @db.VarChar(100)
  birthDate                DateTime                    @map("birth_date")
  address                  String                      @map("address")
  phone                    String                      @map("phone") @db.VarChar(20)
  email                    String                      @unique @map("email") @db.VarChar(150)
  nationality              String                      @map("nationality") @db.VarChar(50)
  socialSecurityNumber     String                      @map("social_security_number") @db.VarChar(50)
  positions                String                      @map("positions") @db.VarChar(100)
  department               String                      @map("department") @db.VarChar(100)
  hireDate                 DateTime                    @map("hire_date")
  workLocation             String                      @map("work_location") @db.VarChar(100)
  baseSalary               Decimal                     @default(0) @map("base_salary") @db.Decimal(15, 2)
  bonus                    Decimal                     @default(0) @map("bonus") @db.Decimal(15, 2)
  benefits                 String[]                    @map("benefits")
  lastSalaryAdjustmentDate DateTime?                   @map("last_salary_adjustment_date")
  leaveBalance             Decimal?                    @default(0) @map("leave_balance") @db.Decimal(5, 2)
  subsidiaryId             String                      @map("subsidiary_id") @db.Uuid
  managerId                String?                     @map("manager_id") @db.Uuid
  gender                   Gender                      @map("gender")
  contractType             ContractType                @map("contract_type")
  status                   EmployeeStatus              @map("status")
  paymentMethod            PaymentMethod               @map("payment_method")
  absenceRecords           AbsenceRecord[]
  attendanceRecords        AttendanceRecord[]
  documents                EmployeeDocument[]
  leaveRecords             EmployeeLeaveRecord[]
  performanceReviews       EmployeePerformanceReview[]
  positionHistory          EmployeePositionHistory[]
  trainings                EmployeeTraining[]
  manager                  Employee?                   @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates             Employee[]                  @relation("EmployeeManager")
  subsidiary               Subsidiary                  @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  leads                    Lead[]
  meetingParticipants      MeetingParticipant[]
  payrollRecords           PayrollRecord[]
  secretariatTasks         SecretariatTask[]

  @@map("employees")
}

model EmployeeDocument {
  id           Int          @id @default(autoincrement()) @map("id")
  documentName String       @map("document_name") @db.VarChar(255)
  url          String       @map("url")
  employeeId   String       @map("employee_id") @db.Uuid
  docType      DocumentType @map("doc_type")
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_documents")
}

model EmployeePositionHistory {
  id               Int       @id @default(autoincrement()) @map("id")
  employeePosition String    @map("employee_position") @db.VarChar(100)
  department       String?   @map("department") @db.VarChar(100)
  startDate        DateTime  @map("start_date")
  endDate          DateTime? @map("end_date")
  employeeId       String    @map("employee_id") @db.Uuid
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_position_history")
}

model EmployeeTraining {
  id           Int      @id @default(autoincrement()) @map("id")
  trainingName String   @map("training_name") @db.VarChar(255)
  trainingDate DateTime @map("training_date")
  provider     String?  @map("provider") @db.VarChar(255)
  employeeId   String   @map("employee_id") @db.Uuid
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_trainings")
}

model EmployeePerformanceReview {
  id             Int      @id @default(autoincrement()) @map("id")
  reviewDate     DateTime @map("review_date")
  reviewer       String?  @map("reviewer") @db.VarChar(255)
  rating         Int?     @map("rating")
  reviewComments String?  @map("review_comments")
  employeeId     String   @map("employee_id") @db.Uuid
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_performance_reviews")
}

model EmployeeLeaveRecord {
  id              Int       @id @default(autoincrement()) @map("id")
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  days            Int       @map("days")
  employeeId      String    @map("employee_id") @db.Uuid
  leaveRecordType LeaveType @map("leave_record_type")
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_leave_records")
}

model Account {
  id            String        @id @default(uuid()) @map("id") @db.Uuid
  accountName   String        @map("account_name") @db.VarChar(255)
  industry      String        @map("industry") @db.VarChar(255)
  phone         String        @map("phone") @db.VarChar(255)
  address       String        @map("address")
  subsidiaryId  String        @map("subsidiary_id") @db.Uuid
  salesRepId    String?       @map("sales_rep_id") @db.Uuid
  salesRep      User?         @relation(fields: [salesRepId], references: [id])
  subsidiary    Subsidiary    @relation(fields: [subsidiaryId], references: [id])
  contacts      Contact[]
  opportunities Opportunity[]
  
   @@unique([accountName, subsidiaryId])

  @@map("accounts")
}

model Contact {
  id            String         @id @default(uuid()) @map("id") @db.Uuid
  contactName   String         @map("contact_name") @db.VarChar(255)
  company       String         @map("company") @db.VarChar(255)
  email         String         @unique @map("email") @db.VarChar(255)
  phone         String         @map("phone") @db.VarChar(255)
  since         DateTime       @map("since")
  address       String         @map("address")
  passwordHash  String         @map("password_hash")
  isVerified    Boolean        @default(false) @map("is_verified")
  accountId     String?        @map("account_id") @db.Uuid
  salesRepId    String?        @map("sales_rep_id") @db.Uuid
  subsidiaryId  String?        @map("subsidiary_id") @db.Uuid
  status        ContactStatus? @map("status")
  account       Account?       @relation(fields: [accountId], references: [id])
  creditAccount CreditAccount?
  salesRep      User?          @relation(fields: [salesRepId], references: [id])
  subsidiary    Subsidiary?     @relation(fields: [subsidiaryId], references: [id])
  contracts     Contract[]
  crmTasks      CrmTask[]
  interactions  Interaction[]
  opportunities Opportunity[]
  orders        Order[]
  sales         Sale[]

  @@map("contacts")
}

enum CustomerPaymentMethod {
  CASH
  CARD
  CHECK
  MOBILE_MONEY
  PAYCAAP
  PAY_ON_DELIVERY
  CUSTOMER_CREDIT

  @@map("customer_payment_method")
}

model Sale {
  id           String     @id @default(uuid()) @map("id") @db.Uuid
  productName  String     @map("product_name") @db.VarChar(255)
  quantity     Int        @map("quantity")
  totalPrice   Decimal    @map("total_price") @db.Decimal(15, 2)
  saleDate     DateTime   @default(now()) @map("sale_date")
  customerName String     @map("customer_name") @db.VarChar(255)
  taxRate      Decimal    @map("tax_rate") @db.Decimal(5, 2)
  paymentMethod CustomerPaymentMethod @map("payment_method")
  customerId   String     @map("customer_id") @db.Uuid
  subsidiaryId String     @map("subsidiary_id") @db.Uuid
  salesRepId   String?    @map("sales_rep_id") @db.Uuid
  orderId      String?    @map("order_id") @db.Uuid
  status       SaleStatus @map("status")
  customer     Contact    @relation(fields: [customerId], references: [id])
  salesRep     User?      @relation(fields: [salesRepId], references: [id])
  order        Order?     @relation(fields: [orderId], references: [id])
  subsidiary   Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@map("sale")
}

model TaxRate {
  id           String  @id @default(uuid()) @map("id") @db.Uuid
  taxRatesName String  @map("tax_rates_name") @db.VarChar(255)
  rate         Decimal @map("rate") @db.Decimal(5, 4)
  isDefault    Boolean @default(false) @map("is_default")
  description  String? @map("description")
  orders       Order[]

  @@map("tax_rates")
}

model Opportunity {
  id                String               @id @default(uuid()) @map("id") @db.Uuid
  opportunityName   String               @map("opportunity_name") @db.VarChar(255)
  opportunityValue  Decimal              @map("opportunity_value") @db.Decimal(15, 2)
  closeDate         DateTime             @map("close_date")
  contactId         String               @map("contact_id") @db.Uuid
  accountId         String               @map("account_id") @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  subsidiaryId      String               @map("subsidiary_id") @db.Uuid
  stage             OpportunityStage     @map("stage")
  sourceOpportunity OpportunitySource?   @map("source_opportunity")
  crmTasks          CrmTask[]
  account           Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact           Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  subsidiary        Subsidiary           @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  products          OpportunityProduct[]
  orders            Order[]

  @@map("opportunities")
}

model OpportunityProduct {
  id            String      @id @default(uuid()) @map("id") @db.Uuid
  opportunityId String      @map("opportunity_id") @db.Uuid
  productId     String      @map("product_id") @db.Uuid
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("opportunity_products")
}

model OrderGroup {
  id            String   @id @default(uuid()) @db.Uuid
  groupCode     String   @unique @map("group_code") 
  customerId    String   @map("customer_id") @db.Uuid
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  orders        Order[]  

  @@map("order_group")
}

model Order {
  id                String                   @id @default(uuid()) @map("id") @db.Uuid
  orderDate         DateTime                 @default(now()) @map("order_date")
  customerName      String                   @map("customer_name") @db.VarChar(255)
  subtotal          Decimal                  @default(0) @map("subtotal") @db.Decimal(15, 2)
  taxAmount         Decimal                  @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount       Decimal                  @default(0) @map("total_amount") @db.Decimal(15, 2)
  taxRateValue      Decimal                  @map("tax_rate_value") @db.Decimal(5, 2)
  amountPaid        Decimal                  @default(0) @map("amount_paid") @db.Decimal(15, 2)
  paymentMethod     CustomerPaymentMethod?   @map("payment_method")
  paymentDueDate    DateTime                 @map("payment_due_date")
  customerId        String                   @map("customer_id") @db.Uuid
  subsidiaryId      String                   @map("subsidiary_id") @db.Uuid
  taxRateId         String                   @map("tax_rate_id") @db.Uuid
  salesRepId        String?                  @map("sales_rep_id") @db.Uuid
  opportunityId     String?                  @map("opportunity_id") @db.Uuid
  groupId           String?                  @map("group_id") @db.Uuid
  status            OrderStatus              @map("status")
  productionStatus  ProductionStatus         @map("production_status")
  paymentStatus     PaymentStatus            @map("payment_status")
  source            OrderSource              @map("source")
  sales             Sale[]
  orderItems        OrderItem[]
  productionHistory OrderProductionHistory[]
  customer          Contact                  @relation(fields: [customerId], references: [id])
  opportunity       Opportunity?             @relation(fields: [opportunityId], references: [id])
  salesRep          User?                    @relation(fields: [salesRepId], references: [id])
  subsidiary        Subsidiary               @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  taxRate           TaxRate                  @relation(fields: [taxRateId], references: [id])
  orderGroup        OrderGroup?              @relation(fields: [groupId], references: [id])

  @@map("orders")
}

model OrderProductionHistory {
  id         Int              @id @default(autoincrement()) @map("id")
  changeDate DateTime         @default(now()) @map("change_date")
  orderId    String           @map("order_id") @db.Uuid
  status     ProductionStatus @map("status")
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_production_history")
}

model OrderItem {
  id             String          @id @default(uuid()) @map("id") @db.Uuid
  quantity       Int             @map("quantity")
  unitPrice      Decimal         @map("unit_price") @db.Decimal(15, 2)
  designFileName String?         @map("design_file_name") @db.VarChar(255)
  designFileUrl  String?         @map("design_file_url")
  productId      String?         @map("product_id") @db.Uuid
  orderId        String?         @map("order_id") @db.Uuid
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productOptions ProductOption[]

  @@map("order_item")
}

model ProductOption {
  id          Int        @id @default(autoincrement()) @map("id")
  optionType  String     @map("option_type")
  optionValue String     @map("option_value") @db.VarChar(150)
  orderItemId String?    @map("order_item_id") @db.Uuid
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("product_option")
}

model Kpi {
  id         String     @id @default(uuid()) @map("id") @db.Uuid
  titleKey   String     @map("title_key") @db.VarChar(100)
  kpiValue   String     @map("kpi_value") @db.VarChar(50)
  change     String     @map("change") @db.VarChar(50)
  changeType ChangeType @map("change_type")

  @@map("kpi")
}

model Supplier {
  id             String          @id @default(uuid()) @map("id") @db.Uuid
  supplierName   String          @map("supplier_name") @db.VarChar(255)
  company        String          @map("company") @db.VarChar(255)
  email          String          @map("email") @db.VarChar(255)
  phone          String          @map("phone") @db.VarChar(255)
  address        String          @map("address")
  subsidiaryId   String          @map("subsidiary_id") @db.Uuid
  purchaseOrders PurchaseOrder[]
  subsidiary     Subsidiary      @relation(fields: [subsidiaryId], references: [id])

  @@map("suppliers")
}

model PurchaseOrder {
  id                   String                 @id @default(uuid()) @map("id") @db.Uuid
  supplierName         String                 @map("supplier_name") @db.VarChar(255)
  orderDate            DateTime               @map("order_date")
  expectedDeliveryDate DateTime               @map("expected_delivery_date")
  totalAmount          Decimal                @map("total_amount") @db.Decimal(15, 2)
  amountPaid           Decimal                @map("amount_paid") @db.Decimal(15, 2)
  supplierId           String                 @map("supplier_id") @db.Uuid
  subsidiaryId         String                 @map("subsidiary_id") @db.Uuid
  status               PurchaseOrderStatus    @map("status")
  paymentTerms         PaymentTerms           @map("payment_terms")
  paymentStatus        PaymentStatus          @map("payment_status")
  purchaseOrderHistory PurchaseOrderHistory[]
  purchaseOrderItems   PurchaseOrderItem[]
  subsidiary           Subsidiary             @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  supplier             Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierDebts        SupplierDebt[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               Int           @id @default(autoincrement()) @map("id")
  productName      String        @map("product_name") @db.VarChar(255)
  quantity         Int           @map("quantity")
  quantityReceived Int           @map("quantity_received")
  purchasePrice    Decimal       @map("purchase_price") @db.Decimal(15, 2)
  purchaseOrderId  String        @map("purchase_order_id") @db.Uuid
  productId        String        @map("product_id") @db.Uuid
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model PurchaseOrderHistory {
  id              Int           @id @default(autoincrement()) @map("id")
  eventName       String        @map("event_name") @db.VarChar(255)
  eventDate       DateTime      @default(now()) @map("event_date")
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_history")
}

model CreditAccount {
  id              String     @id @default(uuid()) @map("id") @db.Uuid
  clientName      String     @map("client_name") @db.VarChar(255)
  companyName     String     @map("company_name") @db.VarChar(255)
  balance         Decimal    @map("balance") @db.Decimal(15, 2)
  lastPaymentDate DateTime   @map("last_payment_date")
  contactId       String     @unique @map("contact_id") @db.Uuid
  contact         Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  subsidiaryId    String     @map("subsidiary_id") @db.Uuid
  subsidiary      Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@map("credit_account")
}

model TreasuryAccount {
  id           String     @id @default(uuid()) @map("id") @db.Uuid
  accountName  String     @map("account_name") @db.VarChar(255)
  balance      Decimal    @map("balance") @db.Decimal(15, 2)
  currency     String     @map("currency") @db.VarChar(10)
  subsidiaryId String     @map("subsidiary_id") @db.Uuid
  subsidiary   Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@map("treasury_accounts")
}

model FinancialTransaction {
  id                       String            @id @default(uuid()) @map("id") @db.Uuid
  transactionDate          DateTime          @map("transaction_date")
  description              String?           @map("description")
  amount                   Decimal           @map("amount") @db.Decimal(15, 2)
  account                  String            @map("account") @db.VarChar(255)
  relatedDocumentId        String?           @map("related_document_id") @db.VarChar(50)
  subsidiaryId             String            @map("subsidiary_id") @db.Uuid
  financialTransactionType TransactionType   @map("financial_transaction_type")
  status                   TransactionStatus @map("status")
  subsidiary               Subsidiary        @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@map("financial_transactions")
}

model CompanyDocument {
  id           String           @id @default(uuid()) @map("id") @db.Uuid
  documentName String           @map("document_name") @db.VarChar(255)
  uploadDate   DateTime         @default(now()) @map("upload_date")
  fileUrl      String           @map("file_url")
  subsidiaryId String           @map("subsidiary_id") @db.Uuid
  category     DocumentCategory @map("category")
  status       DocumentStatus   @map("status")
  subsidiary   Subsidiary       @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@map("company_documents")
}

model Meeting {
  id              String               @id @default(uuid()) @map("id") @db.Uuid
  title           String               @db.VarChar(255)
  meetingDate     DateTime             @map("meeting_date")
  meetingTime     DateTime             @map("meeting_time")
  meetingLocation String?              @map("meeting_location") @db.VarChar(255)
  agenda          String?
  minutes         String?
  subsidiaryId    String               @map("subsidiary_id") @db.Uuid
  participants    MeetingParticipant[]
  subsidiary      Subsidiary           @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@map("meetings")
}

model MeetingParticipant {
  id         Int      @id @default(autoincrement()) @map("id")
  meetingId  String   @map("meeting_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, employeeId])
  @@map("meeting_participants")
}

model SecretariatTask {
  id           String                @id @default(uuid()) @map("id") @db.Uuid
  title        String                @db.VarChar(255)
  description  String
  dueDate      DateTime              @map("due_date")
  assignedToId String?               @map("assigned_to_id") @db.Uuid
  subsidiaryId String                @map("subsidiary_id") @db.Uuid
  status       SecretariatTaskStatus @map("status")
  assignedTo   Employee?             @relation(fields: [assignedToId], references: [id])
  subsidiary   Subsidiary            @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@map("secretariat_tasks")
}

model Interaction {
  id               String          @id @default(uuid()) @map("id") @db.Uuid
  interactionDate  DateTime        @map("interaction_date")
  notes            String
  contactId        String          @map("contact_id") @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  typeInteractions InteractionType @map("type_interactions")
  contact          Contact         @relation(fields: [contactId], references: [id])
  user             User            @relation(fields: [userId], references: [id])

  @@map("interactions")
}

model CrmTask {
  id            String          @id @default(uuid()) @map("id") @db.Uuid
  title         String          @db.VarChar(255)
  description   String?
  dueDate       DateTime        @map("due_date")
  contactId     String          @map("contact_id") @db.Uuid
  opportunityId String?         @map("opportunity_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  status        CrmTaskStatus
  priority      CrmTaskPriority
  contact       Contact         @relation(fields: [contactId], references: [id])
  opportunity   Opportunity?    @relation(fields: [opportunityId], references: [id])
  user          User            @relation(fields: [userId], references: [id])

  @@map("crm_tasks")
}

model Lead {
  id           String     @id @default(uuid()) @map("id") @db.Uuid
  leadName     String     @map("lead_name") @db.VarChar(255)
  company      String     @db.VarChar(255)
  email        String     @unique @db.VarChar(255)
  phone        String     @db.VarChar(255)
  description  String?
  salesRepId   String?    @map("sales_rep_id") @db.Uuid
  subsidiaryId String     @map("subsidiary_id") @db.Uuid
  status       LeadStatus
  salesRep     Employee?  @relation(fields: [salesRepId], references: [id])
  subsidiary   Subsidiary @relation(fields: [subsidiaryId], references: [id])

  @@map("leads")
}

model Contract {
  id           String         @id @default(uuid()) @map("id") @db.Uuid
  title        String
  startDate    DateTime       @map("start_date")
  endDate      DateTime       @map("end_date")
  amount       Decimal        @db.Decimal(12, 2)
  clientId     String         @map("client_id") @db.Uuid
  subsidiaryId String         @map("subsidiary_id") @db.Uuid
  status       ContractStatus
  client       Contact        @relation(fields: [clientId], references: [id])
  subsidiary   Subsidiary     @relation(fields: [subsidiaryId], references: [id])

  @@map("contracts")
}

model FixedAsset {
  id               String     @id @default(uuid()) @map("id") @db.Uuid
  fixedAssetsName  String     @map("fixed_assets_name") @db.VarChar(255)
  acquisitionDate  DateTime   @map("acquisition_date")
  acquisitionCost  Decimal    @map("acquisition_cost") @db.Decimal(15, 2)
  depreciationRate Decimal    @map("depreciation_rate") @db.Decimal(5, 2)
  subsidiaryId     String     @map("subsidiary_id") @db.Uuid
  subsidiary       Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@map("fixed_assets")
}

model LongTermDebt {
  id             String     @id @default(uuid()) @map("id") @db.Uuid
  debtsName      String     @map("debts_name") @db.VarChar(255)
  initialAmount  Decimal    @map("initial_amount") @db.Decimal(15, 2)
  currentBalance Decimal    @map("current_balance") @db.Decimal(15, 2)
  interestRate   Decimal    @map("interest_rate") @db.Decimal(5, 2)
  maturityDate   DateTime   @map("maturity_date")
  subsidiaryId   String     @map("subsidiary_id") @db.Uuid
  subsidiary     Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@map("long_term_debts")
}

model Equipment {
  id                  String              @id @default(uuid()) @map("id") @db.Uuid
  equipmentName       String              @map("equipment_name") @db.VarChar(255)
  lastMaintenanceDate DateTime            @map("last_maintenance_date")
  nextMaintenanceDate DateTime            @map("next_maintenance_date")
  acquisitionDate     DateTime            @map("acquisition_date")
  acquisitionValue    Decimal             @map("acquisition_value") @db.Decimal(15, 2)
  subsidiaryId        String              @map("subsidiary_id") @db.Uuid
  status              EquipmentStatus
  subsidiary          Subsidiary          @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  maintenanceRecords  MaintenanceRecord[]

  @@map("equipment")
}

model MaintenanceRecord {
  id              String    @id @default(uuid()) @map("id") @db.Uuid
  maintenanceDate DateTime  @map("maintenance_date")
  technician      String    @db.VarChar(255)
  description     String
  maintenanceCost Decimal   @map("maintenance_cost") @db.Decimal(10, 2)
  equipmentId     String    @map("equipment_id") @db.Uuid
  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@map("maintenance_records")
}

model AbsenceRecord {
  id           String      @id @default(uuid()) @map("id") @db.Uuid
  employeeName String      @map("employee_name") @db.VarChar(255)
  startDate    DateTime    @map("start_date")
  endDate      DateTime    @map("end_date")
  reason       String
  documentUrl  String?     @map("document_url")
  employeeId   String      @map("employee_id") @db.Uuid
  subsidiaryId String      @map("subsidiary_id") @db.Uuid
  typeAbsence  AbsenceType @map("type_absence")
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  subsidiary   Subsidiary  @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@map("absence_records")
}

model AttendanceRecord {
  id             String           @id @default(uuid()) @map("id") @db.Uuid
  employeeName   String           @map("employee_name") @db.VarChar(255)
  attendanceDate DateTime         @map("attendance_date")
  arrivalTime    DateTime?        @map("arrival_time")
  departureTime  DateTime?        @map("departure_time")
  breakStartTime DateTime?        @map("break_start_time")
  breakEndTime   DateTime?        @map("break_end_time")
  signature      String?
  employeeId     String           @map("employee_id") @db.Uuid
  subsidiaryId   String           @map("subsidiary_id") @db.Uuid
  status         AttendanceStatus @map("status")
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  subsidiary     Subsidiary       @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@map("attendance_records")
}

model PayrollRecord {
  id            String        @id @default(uuid()) @map("id") @db.Uuid
  employeeName  String        @map("employee_name") @db.VarChar(255)
  payrollPeriod String        @map("payroll_period") @db.VarChar(7)
  grossSalary   Decimal       @map("gross_salary") @db.Decimal(12, 2)
  deductions    Decimal       @db.Decimal(12, 2)
  netSalary     Decimal       @map("net_salary") @db.Decimal(12, 2)
  paymentDate   DateTime?     @map("payment_date")
  signature     String?
  employeeId    String        @map("employee_id") @db.Uuid
  subsidiaryId  String        @map("subsidiary_id") @db.Uuid
  status        PayrollStatus @map("status")
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  subsidiary    Subsidiary    @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@map("payroll_records")
}

model SupplierDebt {
  id              String        @id @default(uuid()) @map("id") @db.Uuid
  supplierName    String        @map("supplier_name") @db.VarChar(255)
  invoiceId       String        @map("invoice_id") @db.VarChar(50)
  dueDate         DateTime      @map("due_date")
  amount          Decimal       @db.Decimal(15, 2)
  invoiceUrl      String?       @map("invoice_url")
  subsidiaryId    String        @map("subsidiary_id") @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  status          DebtStatus    @map("status")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  subsidiary      Subsidiary    @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@map("supplier_debts")
}

model ExpenseRecord {
  id                String          @id @default(uuid()) @map("id") @db.Uuid
  expenseDate       DateTime        @map("expense_date")
  description       String
  amount            Decimal         @db.Decimal(12, 2)
  subsidiaryId      String          @map("subsidiary_id") @db.Uuid
  category          ExpenseCategory @map("category")
  expenseRecordType ExpenseType     @map("expense_record_type")
  subsidiary        Subsidiary      @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@map("expense_records")
}

